# stanok-x1a-test: временный ТЕСТОВЫЙ профиль (R4.2, одноразовая загрузка).
# rev13 (operator review #12): трёхпрофильная модель границы.
#   stanok-worker-x1a-test  — профиль контейнера (назначается Docker'ом): БЕЗ
#     mount/umount/remount/pivot_root. Прямой mount и mount через clone()
#     (профиль наследуется при clone/fork; меняет профиль только exec) запрещены.
#   stanok-bwrap-x1a-test   — mount-capable профиль; достижим ТОЛЬКО exec-переходом
#     /usr/bin/bwrap из worker-профиля. Содержит ровно отаудированные (rev12)
#     setup-операции bwrap и catch-all exec-переход: любая команда, которую bwrap
#     исполняет, попадает в sandbox-профиль (без него `bwrap <binary>` наследовал бы
#     mount-capable профиль — дыра, найденная при разборе rev12).
#   stanok-sandbox-x1a-test — профиль Bash и потомков: mount запрещён; вложенный
#     /usr/bin/bwrap px -> sandbox (недоверенный процесс НЕ может перейти в
#     mount-capable профиль через bwrap).
# Ограничение парсера (проверено apparmor_parser 4.0.1, 2026-10-10): ключевое
# `file,` (все file-права, неявно включая execute) конфликтует с glob-px
# ("merged rule with conflicting x modifiers"); abstractions/base (правила mrixwlk)
# тоже конфликтует с glob без execute. Поэтому bwrap-профиль: БЕЗ base и БЕЗ `file,`
# — file-права перечислены globom без execute (`/** mrwlka`), execute только через
# catch-all px. worker/sandbox остаются с base+`file,` (exact-px для них валидны).
# Загрузка: apparmor_parser -a (ADD). Удаление: apparmor_parser -R.
# Никакие существующие профили в эти не переходят; production не затрагивается.
#
# rev13b (operator review #13): МЕЖПРОФИЛЬНЫЕ ptrace-разрешения УДАЛЕНЫ.
#   AppArmor проверяет обе стороны (trace у tracer, tracedby у target);
#   /proc/<pid>/mem и process_vm_readv медиуются теми же ptrace read/readby
#   правами. Ни один шаг реального пути исполнения (worker -> exec bwrap ->
#   exec команды; bwrap setup; harness) не использует ptrace между профилями,
#   поэтому оставлены ТОЛЬКО ptrace внутри одного профиля (нужен доверенным
#   командам для ptrace собственных потомков — control-тест C1 в W7).
#   Канал bwrap<->sandbox закрывается тестом W7 (strict + weaker): из sandbox
#   PTRACE_ATTACH к PID1 (bwrap), чтение /proc/1/mem, process_vm_readv —
#   ожидаемый отказ; атрибуция отказа AppArmor — через Yama=0 на время теста,
#   ALLOW-правила seccomp на ptrace/process_vm_readv и control C1 (attach к
#   собственному ребёнку, тот же профиль — разрешён).

#include <tunables/global>

profile stanok-worker-x1a-test flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,

  # Граница rev13: контейнерный вход (harness / Claude Code) НЕ монтирует.
  # Профиль наследуется при clone()/fork() — потомок через namespace-clone
  # mount-прав не получает (отрицательный тест W2).
  deny mount,
  deny remount,
  deny umount,
  deny pivot_root,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=stanok-worker-x1a-test,
  signal (send,receive) peer=stanok-bwrap-x1a-test,
  signal (send,receive) peer=stanok-sandbox-x1a-test,

  # Единственный путь к mount-правам: exec закреплённого пути бинаря.
  # (Копия бинаря в другом пути не переходит — тест W3.)
  /usr/bin/bwrap px -> stanok-bwrap-x1a-test,

  # --- docker-default /proc and /sys denies (unchanged) ---
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # rev13b: только ptrace внутри своего профиля (межпрофильные удалены).
  ptrace (trace,tracedby,read,readby) peer=stanok-worker-x1a-test,
}

profile stanok-bwrap-x1a-test flags=(attach_disconnected,mediate_deleted) {
  # БЕЗ abstractions/base и БЕЗ `file,`: конфликт glob-px с неявным execute
  # (см. заголовок). unix-правила — минимальный набор bwrap (--die-with-parent
  # socketpair); file-права — глоб без execute.

  network,
  deny network alg,
  deny network vsock,
  capability,
  unix (create, getattr, getopt, setopt, shutdown),

  # setup-фазе нужны read/map/link/write на любые пути, НО не execute.
  # ('a' с 'w' взаимоисключающи по парсеру — 'w' покрывает append.)
  /** mrwlk,

  # --- bubblewrap mount operations (scoped; rev12 full audit, unchanged) ---
  # Audit basis: bubblewrap v0.8.0 source + kernel v6.8 security/apparmor/mount.c
  # (flag encoding + mediation masks; see SPEC-X1A rev12 record).
  mount options=(rw, silent, rslave) -> /,
  pivot_root,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /tmp/,
  mount options=(rw rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  umount /oldroot/,
  umount /,
  mount options=(rw rbind) /oldroot/ -> /newroot/,
  mount options=(rw rbind) /oldroot/** -> /newroot/**,
  mount options=(rw rbind) /newroot/proc/** -> /newroot/proc/**,
  remount /newroot/{,**},
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/dev/,
  mount fstype=devpts options=(rw nosuid noexec) devpts -> /newroot/dev/pts/,
  mount fstype=proc options=(rw nosuid nodev noexec) proc -> /newroot/proc/,

  # CATCH-ALL: всё, что bwrap исполняет, теряет mount-права.
  # Без этого правила `bwrap <binary>` (не shell) наследовал бы mount-capable
  # профиль — именно эту дыру показал разбор E3 в rev12.
  /** px -> stanok-sandbox-x1a-test,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=stanok-bwrap-x1a-test,
  signal (send,receive) peer=stanok-sandbox-x1a-test,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # rev13b: только ptrace внутри своего профиля.
  ptrace (trace,tracedby,read,readby) peer=stanok-bwrap-x1a-test,
}

profile stanok-sandbox-x1a-test flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,

  # the inheritance block: sandboxed commands (and their descendants)
  # cannot mount, remount, pivot_root or umount anything — ни напрямую,
  # ни через clone() (профиль наследуется).
  deny mount,
  deny remount,
  deny umount,
  deny pivot_root,

  # nested bwrap from a sandboxed process stays confined (mount stays denied) —
  # explicit, so P8 does not depend on the absence of a rule
  /usr/bin/bwrap px -> stanok-sandbox-x1a-test,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # rev13b: только ptrace внутри своего профиля (нужен для control-теста C1:
  # команда ptrace'ит собственных детей; межпрофильные каналы закрыты).
  ptrace (trace,tracedby,read,readby) peer=stanok-sandbox-x1a-test,
}
