# stanok-bwrap-x1a-test: временный ТЕСТОВЫЙ профиль (R4.2, одноразовая загрузка).
# rev12 (operator review #11): полный аудит mount-правил по исходнику bubblewrap
# v0.8.0 и kernel v6.8 security/apparmor/mount.c. Исправлены bind-комбинации
# (options= — точное совпадение; ядро кодирует MS_BIND|MS_REC как 'rbind', а
# aa_bind_mount() обрезает флаги до MS_REC|MS_BIND -> 'rw, rbind'), добавлены
# rprivate-правило для oldroot (change-type, не remount) и umount / (второй pivot,
# main :2651), удалены мёртвые правила (remount /, remount /oldroot, options=(bind),
# options=(bind,rbind), options=(bind,ro)). Расширения разрешений НЕТ.
# Копия /tmp/x1a/stanok-bwrap.apparmor с уникальными тестовыми именами.
# Загрузка: apparmor_parser -a (ADD; в 4.0.1 -W = --write-cache, НЕ add).
# Удаление: apparmor_parser -R.
# Никакие существующие профили не переходят в эти; production-профили не затрагиваются.
#
# Переходы (исправлены по замечанию оператора, 2026-10-10): широких правил вида
# /usr/bin/* НЕТ и не будет. Пути проверены в образе (2026-10-10): bwrap =
# /usr/bin/bwrap (обычный файл); /bin/sh резолвится в /usr/bin/dash — фактический
# переход песочничной оболочки идёт по правилу /usr/bin/dash. bwrap пинится
# ЯВНО в обоих профилях, чтобы поведение не зависело от «нет правила → наследуй».
# change_profile в обоих профилях ОТСУТСТВУЕТ: он не требуется ни назначению
# профиля при старте контейнера, ни px-переходам (см. комментарий в entry-профиле).

#include <tunables/global>

profile stanok-bwrap-x1a-test flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # change_profile ЗДЕСЬ НЕ НУЖЕН (исправлено по замечанию оператора, 2026-10-10):
  # назначение профиля при старте контейнера (--security-opt apparmor=...) —
  # механизм запуска: право смены проверяется против ТЕКУЩЕГО (host-side) профиля
  # процесса ДО смены, а не против целевого профиля (прецедент: docker-default не
  # содержит change_profile и назначается корректно). Exec-переходы ниже — px-правила,
  # права change_profile они не требуют; явных смен профиля тест не выполняет.

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=stanok-bwrap-x1a-test,
  signal (send,receive) peer=stanok-sandbox-x1a-test,

  # --- bubblewrap mount operations (scoped; rev12 full audit) ---
  # Audit basis (2026-10-10): bubblewrap v0.8.0 source (bubblewrap.c, bind-mount.c)
  # + kernel v6.8 security/apparmor/mount.c (flag encoding + mediation masks).
  # Kernel flag encoding (audit_mnt_flags, mount.c): MS_BIND|MS_REC -> 'rbind'
  # (NEVER 'bind'+'rbind' together); MS_BIND alone -> 'bind'; MS_REC|MS_PRIVATE ->
  # 'rprivate'; MS_REC|MS_SLAVE -> 'rslave'; MS_SILENT -> 'silent'; rw always shown.
  # Mediation masks (mount.c):
  #   aa_bind_mount(): flags &= MS_REC|MS_BIND -> every INITIAL bind is mediated as
  #     'rw, rbind' only (silent/ro/nosuid stripped);
  #   aa_mount_change_type(): flags &= MS_REC|MS_SILENT|MS_SHARED|MS_PRIVATE|MS_SLAVE|
  #     MS_UNBINDABLE -> change-type ops mediated as 'rw, silent, rprivate/rslave';
  #   aa_remount(): full flags passed -> remount rules carry NO options= (any flags).
  # All bwrap binds are recursive (PRIV_SEP_OP_BIND_MOUNT always BIND_RECURSIVE,
  # bubblewrap.c:964) -> bare 'bind' never appears in the audit; a rule with bare
  # 'bind' is dead (rev11's options=(bind) / options=(bind,rbind) / options=(bind,ro)
  # were exact-match mismatches — removed, not widened).
  # Path semantics (apparmor.d(5), confirmed by run2 kernel audit 2026-10-10:
  # DENIED info="failed srcname match" name="/tmp/" srcname="tmpfs"): for the
  # 'mount' keyword a path WITHOUT '->' is the SOURCE device; the mountpoint is
  # only the path AFTER '->'. 'remount'/'umount' take the MOUNTPOINT directly.
  # Directory mountpoints appear in the audit WITH a trailing slash (aa_path_name,
  # PATH_IS_DIR) — rules below use trailing slashes accordingly.
  # Unspecified conditionals match ANY value (apparmor.d(5)) — every new-mount
  # rule below pins fstype + srcname + options= exactly (operator review #10).
  # rslave on / (main :2551, MS_SILENT|MS_SLAVE|MS_REC): empirically confirmed —
  # run2 passed this exact rule (run1 DENIED flags="rw, silent, rslave").
  mount options=(rw, silent, rslave) -> /,
  pivot_root,
  # root tmpfs at base_path=/tmp (main :2554, MS_NODEV|MS_NOSUID): run2 DENIED
  # flags="rw, nosuid, nodev" srcname="tmpfs" — this rule's flags/srcname matched.
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /tmp/,
  # newroot self-bind (main :2568, mount("newroot","newroot",MS_SILENT|MS_MGC_VAL|
  # MS_BIND|MS_REC), CWD=/tmp): mediated as 'rw, rbind' (aa_bind_mount mask).
  mount options=(rw rbind) /tmp/newroot/ -> /tmp/newroot/,
  # oldroot make-rprivate (main :2622, MS_SILENT|MS_REC|MS_PRIVATE): change-type op,
  # mediated as 'rw, silent, rprivate' on the mountpoint only (no srcname in audit).
  # NOT a remount — rev11's 'remount /oldroot' was a dead rule; removed.
  mount options=(rw, silent, rprivate) -> /oldroot/,
  # umount oldroot (main :2624, umount2 MNT_DETACH) and umount of the old root
  # after the second pivot (main :2651, umount2(".") -> mountpoint '/'):
  # the latter was MISSING in rev11 (the published abstraction has 'umount /').
  umount /oldroot/,
  umount /,
  # root bind (--ro-bind / /: setup_newroot :1058-1072, src=/oldroot/ dest=/newroot/)
  # and every other bind /oldroot/** -> /newroot/** (dev nodes :1121-1131 etc.):
  # initial bind mediated as 'rw, rbind'; ro/nosuid are applied by the remount step
  # (bind-mount.c:452,472) -> covered by the remount rule below, not by options= here.
  mount options=(rw rbind) /oldroot/ -> /newroot/,
  mount options=(rw rbind) /oldroot/** -> /newroot/**,
  # proc covers (setup_newroot :1099-1113): recursive ro self-binds at
  # /newroot/proc/{sys,sysrq-trigger,irq,bus} — initial bind mediated as 'rw, rbind'
  # (BIND_READONLY is stripped by the aa_bind_mount mask; ro lands in the remount step).
  mount options=(rw rbind) /newroot/proc/** -> /newroot/proc/**,
  # remount steps of bind_mount (bind-mount.c:452,472) at /newroot/ and below
  # (full flags to aa_remount -> no options= here). '{,**}' matches /newroot/ itself
  # (the root-bind remount) AND everything below it; bare '**' does NOT match the
  # directory itself. rev11's 'remount /' was dead (no remount op on /) — removed.
  remount /newroot/{,**},
  # --dev /dev: tmpfs (SETUP_MOUNT_DEV :1115-1120) + devpts (:1149-1158,
  # data "newinstance,ptmxmode=0666,mode=620" — data not matched by these rules)
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/dev/,
  mount fstype=devpts options=(rw nosuid noexec) devpts -> /newroot/dev/pts/,
  # --proc /proc with --unshare-pid (privileged_op :971); the weaker mode binds
  # oldroot/proc instead — covered by the rbind rules above (setup_newroot :1091-1093)
  mount fstype=proc options=(rw nosuid nodev noexec) proc -> /newroot/proc/,

  # --- bwrap stays in the mount-capable entry profile through setup: explicit
  # pin (exec from entry -> entry), independent of "no rule -> inherit". ---
  /usr/bin/bwrap px -> stanok-bwrap-x1a-test,

  # --- exec transitions: untrusted commands lose mount permissions ---
  /bin/sh px -> stanok-sandbox-x1a-test,
  /bin/bash px -> stanok-sandbox-x1a-test,
  /bin/dash px -> stanok-sandbox-x1a-test,
  /usr/bin/sh px -> stanok-sandbox-x1a-test,
  /usr/bin/bash px -> stanok-sandbox-x1a-test,
  /usr/bin/dash px -> stanok-sandbox-x1a-test,

  # --- docker-default /proc and /sys denies (unchanged) ---
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=stanok-bwrap-x1a-test,
  ptrace (trace,tracedby,read,readby) peer=stanok-sandbox-x1a-test,
}

profile stanok-sandbox-x1a-test flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=stanok-bwrap-x1a-test,
  signal (send,receive) peer=stanok-sandbox-x1a-test,

  # the inheritance block: sandboxed commands (and their descendants)
  # cannot mount, remount, pivot_root or umount anything
  deny mount,
  deny umount,

  # nested bwrap from a sandboxed process stays confined (mount stays denied) —
  # explicit, so P8 does not depend on the absence of a rule
  /usr/bin/bwrap px -> stanok-sandbox-x1a-test,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=stanok-sandbox-x1a-test,
  ptrace (trace,tracedby) peer=stanok-bwrap-x1a-test,
}
